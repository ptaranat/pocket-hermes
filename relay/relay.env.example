# Address the relay listens on. Use your Tailscale IP, not a public interface.
RELAY_HOST=100.x.y.z
RELAY_PORT=8643
# File holding a long random token, shared with the handheld.
RELAY_TOKEN_FILE=/home/you/.config/pocket-hermes/token

# Hermes API server.
HERMES_URL=http://127.0.0.1:8642
API_SERVER_KEY=

# Optional: read replies aloud with Cartesia. Leave empty for text only.
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=

# Optional extras.
# WHISPER_MODEL=base.en
# RELAY_EXTRA_RULES=Prefer metric units.
# RELAY_TOOL_LABELS={"my_tool": "Checking my thing"}
